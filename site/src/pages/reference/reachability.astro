<DocsLayout title="Reachability reference" kicker="14 / reference" description="Traversal, connected-component, and shortcut-set entry points for directed graphs.">
  <pre><code>from reachq.reachability import (
    bfs_reachability,
    parallel_bfs,
    strongly_connected_components,
