---
import '../docs.css'
import '../docs-index.css'

const { title, kicker, description } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/reachq/favicon.svg" />
    <title>{title} · reachq</title>
  </head>
  <body>
    <header class="docs-header">
      <div class="docs-shell docs-nav">
        <a class="docs-brand" href="/reachq/" aria-label="reachq home">
          <img src="/reachq/logo.svg" alt="reachq" />
        </a>
        <nav aria-label="Documentation navigation">
          <a href="/reachq/getting-started.html">Start here</a>
          <a href="/reachq/reference.html">Reference</a>
          <a href="/reachq/status.html">Status</a>
          <a href="/reachq/limitations.html">Limits</a>
          <a href="https://github.com/sachncs/reachq" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main class="docs-shell docs-main">
      <div class="docs-kicker">{kicker}</div>
      <h1>{title}</h1>
      <p class="docs-lede">{description}</p>
      <div class="docs-content">
        <slot />
      </div>
      <aside class="docs-index" aria-label="Documentation map">
        <div>
          <strong>Learn</strong>
          <a href="/reachq/getting-started/installation.html">Installation</a>
          <a href="/reachq/getting-started/reachability.html">Reachability</a>
          <a href="/reachq/getting-started/shortest-paths.html">Shortest paths</a>
          <a href="/reachq/getting-started/examples.html">Examples</a>
        </div>
        <div>
          <strong>Understand</strong>
          <a href="/reachq/concepts/shortcut-sets.html">Shortcut sets</a>
          <a href="/reachq/concepts/hopsets.html">Hopsets</a>
          <a href="/reachq/concepts/correctness.html">Correctness</a>
          <a href="/reachq/concepts/limitations.html">Limitations</a>
        </div>
        <div>
          <strong>Build</strong>
          <a href="/reachq/guides/parameters.html">Parameters</a>
          <a href="/reachq/guides/serialization.html">Serialization</a>
          <a href="/reachq/guides/benchmarking.html">Benchmarking</a>
          <a href="/reachq/reference.html">API reference</a>
        </div>
        <div>
          <strong>Project</strong>
          <a href="/reachq/research/provenance.html">Research</a>
          <a href="/reachq/project/contributing.html">Contributing</a>
          <a href="/reachq/project/roadmap.html">Roadmap</a>
          <a href="/reachq/archive.html">Archive</a>
        </div>
      </aside>
    </main>
    <footer class="docs-footer docs-shell">
      <span>Graph reachability, queryable.</span>
      <a href="/reachq/">Back to the product page →</a>
    </footer>
  </body>
</html>
